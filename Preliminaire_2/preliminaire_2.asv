%% Préliminaire 2
clc
clear
close all

% Récupération d'un signal
data = load('./Signaux_parole/fcno01fz.mat');
signal = data.fcno01fz;

% Paramètes
RSB_dB = 10;
Fs = 8000;

% Bruitage du signal
signal_bruite = bruitage(signal, RSB_dB);

% Affichage des signaux
N = length(signal);
t = (0 : N-1) / Fs;

figure(1);

subplot(121);
plot(t,)






